APP_NAME=Libreria Ingles API
APP_ENV=local
API_V1_PREFIX=/api/v1
DATABASE_URL=sqlite:///./data/libreria_ingles.db
CORS_ORIGINS=http://localhost:4200

# --- Autenticación ---
# Secreto para firmar la sesión y HMAC internos (mínimo 32 caracteres). Cambiarlo fuera de local.
JWT_SECRET=cambiar-por-un-secreto-largo-de-al-menos-32-caracteres
# Client ID de Google (Google Cloud Console → Credenciales → ID de cliente OAuth, tipo Web).
# Orígenes autorizados: http://localhost:4200
GOOGLE_CLIENT_ID=
# Login sin Google, solo para desarrollo local (se ignora en production).
DEV_LOGIN_ENABLED=true
# Emails que reciben el rol PLATFORM_OWNER al ingresar (separados por coma).
PLATFORM_OWNER_EMAILS=sr.macros@gmail.com

# --- Cifrado de API keys ---
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Si queda vacío en local, se deriva de JWT_SECRET (cambiar JWT_SECRET invalida las keys guardadas).
ENCRYPTION_KEY=

# --- IA ---
# Proveedor simulado para probar sin API keys (se ignora en production).
MOCK_AI_ENABLED=true
AI_TIMEOUT_SECONDS=60

# --- Alta corporativa P01 ---
# Índice local del padrón oficial del Registro Nacional de Sociedades (RNS).
ORGANIZATION_REGISTRY_PATH=data/rns_registry.db
# Fallback DEV cuando todavía no se sincronizó el padrón oficial.
# El backend lo ignora en production aunque quede true.
ORGANIZATION_VERIFICATION_MOCK_ENABLED=true

# --- Verificación P02 ---
VERIFICATION_CODE_TTL_MINUTES=25
VERIFICATION_MAX_ATTEMPTS=3
VERIFICATION_RESEND_COOLDOWN_SECONDS=60
# Máximo de códigos generados por un mismo onboarding/contexto en una hora.
VERIFICATION_MAX_SENDS_PER_HOUR=5
# Defensa adicional: evita bombardear el mismo buzón usando varios contextos/onboardings.
VERIFICATION_MAX_SENDS_PER_DESTINATION_PER_HOUR=5

# Delivery de email: dev | smtp
# dev no envía correo y permite mostrar el OTP únicamente fuera de production.
EMAIL_DELIVERY_PROVIDER=dev

# Primer provider real opcional. Para Gmail puede usarse smtp.gmail.com:587 + STARTTLS
# y una contraseña de aplicación cuando la cuenta lo permita. Nunca versionar credenciales reales.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_TIMEOUT_SECONDS=20
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Sr. Marcos

# --- T-220 · SaaS ---
# Marca visible del producto (títulos, encabezado, emails, certificado).
BRAND_NAME=Librería Inglés
# Tareas periódicas (vencimientos, campañas de primer ingreso, correcciones pendientes).
# true = corren en un hilo junto con la API (local). En producción: false acá y un proceso
# aparte con `python -m app.jobs` (o `python -m app.jobs --once` desde un cron).
JOBS_IN_PROCESS=true
JOBS_TICK_SECONDS=30
