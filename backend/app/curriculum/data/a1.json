{
  "level": "A1",
  "name": "Principiante",
  "description": "Usuario básico: frases cotidianas, presentaciones, información personal simple.",
  "areas": [
    {
      "key": "grammar",
      "name": "Grammar",
      "topics": [
        {
          "key": "to_be",
          "name": "To be",
          "skills": [
            {
              "key": "affirmative",
              "name": "Afirmativo (am / is / are)",
              "objectives": ["elegir am/is/are según el sujeto"],
              "exerciseTypes": ["fill_blank", "multiple_choice"],
              "examples": [
                {
                  "type": "fill_blank",
                  "instruction": "Complete with am, is or are.",
                  "question": "My sister ___ a nurse.",
                  "acceptedAnswers": ["is"],
                  "commonErrors": [
                    {"answer": "are", "feedback": "Con he/she/it o un sustantivo singular se usa 'is'.", "conceptResults": [{"concept": "be_agreement", "status": "incorrect"}]}
                  ],
                  "expectedConcepts": ["be_agreement"]
                },
                {
                  "type": "fill_blank",
                  "instruction": "Complete with am, is or are.",
                  "question": "We ___ from Argentina.",
                  "acceptedAnswers": ["are"],
                  "commonErrors": [
                    {"answer": "is", "feedback": "Con we/you/they se usa 'are'.", "conceptResults": [{"concept": "be_agreement", "status": "incorrect"}]}
                  ],
                  "expectedConcepts": ["be_agreement"]
                }
              ]
            },
            {
              "key": "negative",
              "name": "Negativo",
              "objectives": ["formar negativo con not", "usar contracciones isn't / aren't"],
              "exerciseTypes": ["rewrite", "fill_blank"],
              "examples": [
                {
                  "type": "rewrite",
                  "instruction": "Make the sentence negative.",
                  "question": "They are at home.",
                  "acceptedAnswers": ["They are not at home.", "They aren't at home.", "They're not at home."],
                  "commonErrors": [],
                  "expectedConcepts": ["be_negative", "word_order"]
                }
              ]
            },
            {
              "key": "questions",
              "name": "Preguntas",
              "objectives": ["invertir sujeto y verbo to be"],
              "exerciseTypes": ["rewrite", "multiple_choice"],
              "examples": [
                {
                  "type": "rewrite",
                  "instruction": "Make a question.",
                  "question": "He is your brother.",
                  "acceptedAnswers": ["Is he your brother?"],
                  "commonErrors": [
                    {"answer": "He is your brother?", "feedback": "En las preguntas, 'is' va antes del sujeto.", "conceptResults": [{"concept": "be_question_inversion", "status": "incorrect"}]}
                  ],
                  "expectedConcepts": ["be_question_inversion"]
                }
              ]
            }
          ]
        },
        {
          "key": "present_simple",
          "name": "Present Simple",
          "skills": [
            {
              "key": "third_person_singular",
              "name": "Tercera persona (-s / -es)",
              "objectives": ["agregar -s/-es con he/she/it", "verbo base con I/you/we/they"],
              "exerciseTypes": ["fill_blank", "multiple_choice"],
              "examples": [
                {
                  "type": "fill_blank",
                  "instruction": "Complete with the correct form of the verb in brackets.",
                  "question": "Tom ___ (watch) TV every evening.",
                  "acceptedAnswers": ["watches"],
                  "commonErrors": [
                    {"answer": "watch", "feedback": "Con he/she/it, los verbos terminados en -ch agregan -es.", "conceptResults": [{"concept": "third_person_s", "status": "incorrect"}]},
                    {"answer": "watchs", "feedback": "Los verbos terminados en -ch llevan -es, no -s.", "conceptResults": [{"concept": "third_person_s", "status": "correct"}, {"concept": "spelling_es", "status": "incorrect"}]}
                  ],
                  "expectedConcepts": ["third_person_s", "spelling_es"]
                }
              ]
            },
            {
              "key": "negative",
              "name": "Negativo (don't / doesn't)",
              "objectives": ["usar don't/doesn't", "verbo base después de doesn't"],
              "exerciseTypes": ["rewrite", "fill_blank"],
              "examples": [
                {
                  "type": "rewrite",
                  "instruction": "Make the sentence negative.",
                  "question": "She plays tennis.",
                  "acceptedAnswers": ["She doesn't play tennis.", "She does not play tennis."],
                  "commonErrors": [
                    {"answer": "She doesn't plays tennis.", "feedback": "Después de 'doesn't' va el verbo en forma base.", "conceptResults": [{"concept": "doesnt", "status": "correct"}, {"concept": "base_verb_after_doesnt", "status": "incorrect"}]}
                  ],
                  "expectedConcepts": ["doesnt", "base_verb_after_doesnt"]
                }
              ]
            },
            {
              "key": "questions_do_does",
              "name": "Preguntas con do / does",
              "objectives": ["elegir do/does", "verbo base después de does"],
              "exerciseTypes": ["fill_blank", "rewrite"],
              "examples": [
                {
                  "type": "fill_blank",
                  "instruction": "Complete the question with do or does.",
                  "question": "___ she work on Saturdays?",
                  "acceptedAnswers": ["Does"],
                  "commonErrors": [
                    {"answer": "Do", "feedback": "Con he/she/it se usa 'does'.", "conceptResults": [{"concept": "do_does_choice", "status": "incorrect"}]}
                  ],
                  "expectedConcepts": ["do_does_choice"]
                },
                {
                  "type": "rewrite",
                  "instruction": "Make a question.",
                  "question": "Your parents live in Rosario.",
                  "acceptedAnswers": ["Do your parents live in Rosario?"],
                  "commonErrors": [
                    {"answer": "Does your parents live in Rosario?", "feedback": "'Your parents' es plural: se usa 'do'.", "conceptResults": [{"concept": "do_does_choice", "status": "incorrect"}, {"concept": "base_verb_after_do", "status": "correct"}]}
                  ],
                  "expectedConcepts": ["do_does_choice", "base_verb_after_do"]
                }
              ]
            }
          ]
        },
        {
          "key": "present_continuous",
          "name": "Present Continuous",
          "skills": [
            {
              "key": "affirmative",
              "name": "Afirmativo (am/is/are + -ing)",
              "objectives": ["am/is/are + verbo-ing", "ortografía de -ing"],
              "exerciseTypes": ["fill_blank"],
              "examples": [
                {
                  "type": "fill_blank",
                  "instruction": "Complete with the present continuous of the verb in brackets.",
                  "question": "Look! The children ___ (run) in the park.",
                  "acceptedAnswers": ["are running", "'re running"],
                  "commonErrors": [
                    {"answer": "are runing", "feedback": "Se duplica la consonante final: run → running.", "conceptResults": [{"concept": "be_plus_ing", "status": "correct"}, {"concept": "ing_spelling", "status": "incorrect"}]},
                    {"answer": "running", "feedback": "Falta am/is/are antes del verbo con -ing.", "conceptResults": [{"concept": "be_plus_ing", "status": "incorrect"}]}
                  ],
                  "expectedConcepts": ["be_plus_ing", "ing_spelling"]
                }
              ]
            },
            {
              "key": "questions",
              "name": "Preguntas",
              "objectives": ["am/is/are antes del sujeto"],
              "exerciseTypes": ["rewrite"],
              "examples": [
                {
                  "type": "rewrite",
                  "instruction": "Make a question.",
                  "question": "You are listening to music.",
                  "acceptedAnswers": ["Are you listening to music?"],
                  "commonErrors": [],
                  "expectedConcepts": ["be_question_inversion", "be_plus_ing"]
                }
              ]
            }
          ]
        },
